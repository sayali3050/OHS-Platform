# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
POSTGRES_USER=ohs
POSTGRES_PASSWORD=ohs
POSTGRES_DB=ohs
DATABASE_URL=postgresql+psycopg://ohs:ohs@db:5432/ohs

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REMEMBER_ME_DAYS=14

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- AI ---
# Leave empty to run in Demo AI Mode (clearly labelled in the UI; no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=20

# --- Demo or real site ---
# true: a fictional demo organisation with one-click demo sign-ins (for development and presentations).
# false: a real site. No demo people or records; people register themselves or are added by an admin/supervisor.
#        Start from an empty database (docker compose down -v) when switching an existing demo install.
SEED_DEMO_DATA=true
# Password for admin@demo.com, supervisor@demo.com, worker@demo.com and all seeded demo users.
DEMO_PASSWORD=Demo@1234

# First administrator for a real site (created once, at start-up, if that email doesn't exist yet).
# They must choose a new password at first sign-in, so this one is only used once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Password reset emails (optional) ---
# Public address of the app, used in reset links, e.g. http://192.168.0.100:8080 or https://safety.example.com
APP_URL=http://localhost:8080
# Without a mail server the reset link is written to the API log; people without email ask their
# supervisor or an admin for a temporary password (Profile > Reset password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Emergency mode ---
# Real site numbers only, as "Label:number" pairs separated by ";". Example:
#   EMERGENCY_CONTACTS=Site security:+91 20 5555 0100;First-aid room:2222
# Left empty, the emergency screen says no numbers are configured instead of showing a made-up one.
EMERGENCY_CONTACTS=
# Admins can also add site numbers in the app (Emergency screen > Manage numbers).
# National services shown to everyone, as "service:number" (service = emergency, police, fire, ambulance,
# women or disaster). Defaults to India's official numbers: 112, police 100, fire 101, ambulance 108.
# PUBLIC_EMERGENCY_NUMBERS=emergency:112;police:100;fire:101;ambulance:108

# --- Drudgery score ---
# Relative weights of the seven factors (JSON; they don't need to add up to 1). Defaults shown.
# DRUDGERY_WEIGHTS={"repetition":0.15,"load":0.2,"duration":0.15,"posture":0.2,"frequency":0.1,"vibration":0.1,"recovery":0.1}
