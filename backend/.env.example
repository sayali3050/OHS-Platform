# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
POSTGRES_USER=ohs
POSTGRES_PASSWORD=ohs
POSTGRES_DB=ohs
DATABASE_URL=postgresql+psycopg://ohs:ohs@db:5432/ohs

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REMEMBER_ME_DAYS=14

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- AI ---
# Leave empty to run in Demo AI Mode (clearly labelled in the UI; no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=20

# --- Demo ---
# Password for admin@demo.com, supervisor@demo.com, worker@demo.com and all seeded demo users.
DEMO_PASSWORD=Demo@1234

# --- Uploads ---
MAX_UPLOAD_MB=10
